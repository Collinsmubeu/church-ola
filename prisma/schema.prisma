generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String?       // null if OAuth-only
  phone         String?
  photo         String?
  role          Role          @default(GUEST)
  skills        String[]      @default([])
  birthday      DateTime?
  joinDate      DateTime      @default(now())
  isPastor      Boolean       @default(false)
  isActive      Boolean       @default(true)
  provider      String        @default("credentials") // "credentials" | "google"
  events        Event[]
  donations     Donation[]
  volunteerRoles VolunteerRole[]
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]    @relation("ActorLogs")
  targetLogs    AuditLog[]    @relation("TargetLogs")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // "ROLE_CHANGED", "USER_CREATED", "USER_DELETED", "LOGIN", "LOGOUT", "DONATION_VIEWED", etc.
  targetId   String
  targetName String
  actorId    String
  actorName  String
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor      User     @relation("ActorLogs", fields: [actorId], references: [id])
  target     User?    @relation("TargetLogs", fields: [targetId], references: [id])

  @@index([action, createdAt])
  @@index([actorId])
  @@index([targetId])
}

model Attendee {
  id        String   @id @default(cuid())
  name      String
  email     String?
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([eventId])
}

model Event {
  id          String     @id @default(cuid())
  title       String
  description String
  date        DateTime
  time        String
  location    String
  capacity    Int?
  createdBy   User?      @relation(fields: [createdById], references: [id])
  createdById String?
  attendees   Attendee[]
  createdAt   DateTime   @default(now())

  @@index([date])
  @@index([createdById])
}

model Sermon {
  id          String    @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  audioUrl    String?
  speaker     String
  date        DateTime
  duration    Int? // seconds
  createdAt   DateTime  @default(now())

  @@index([date])
  @@index([speaker])
}

model Donation {
  id        String       @id @default(cuid())
  amount    Float
  currency  String       @default("USD")
  type      DonationType @default(ONE_TIME)
  note      String?
  donor     User?        @relation(fields: [donorId], references: [id])
  donorId   String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([donorId])
}

model VolunteerRole {
  id        String   @id @default(cuid())
  team      String
  role      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@unique([userId, team])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PASTOR
  ELDER
  DEACON
  MINISTRY_LEAD
  COUNSELOR
  MEMBER
  GUEST
}

enum DonationType {
  ONE_TIME
  RECURRING
  OFFERING
}